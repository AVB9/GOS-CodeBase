# =================================================================
# FIREBASE CONFIGURATION - ENVIRONMENT VARIABLES
# =================================================================
# SECURITY: This file shows the required environment variables.
# Create a .env file (not .env.example) and populate it with 
# your actual Firebase credentials.
# 
# IMPORTANT: .env should NEVER be committed to git!
# Add ".env" to .gitignore to prevent accidental credential leaks.

# Get these values from Firebase Console:
# https://console.firebase.google.com/

# Web API Key (can be safely exposed in client-side apps when protected by rules)
VITE_FIREBASE_API_KEY=your_api_key_here

# Authentication Domain
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# Firestore Project ID
VITE_FIREBASE_PROJECT_ID=your-project-id

# Cloud Storage Bucket
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Cloud Messaging Sender ID
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012

# App ID
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Google Analytics Measurement ID (optional)
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
